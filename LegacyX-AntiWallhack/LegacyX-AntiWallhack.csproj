<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same as LegacyX-Hud: CounterStrikeSharp.API 1.0.376 ships net10.0 only, and the server runs CounterStrikeSharp on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LegacyX-AntiWallhack</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/LegacyX.Shared.Configuration/LegacyX.Shared.Configuration.csproj" />
  </ItemGroup>
  <!-- The ray trace module (github.com/FUNPLAY-pro-CS2/Ray-Trace, GPL-3.0) is a separate install on the server: its RayTraceApi.dll is the shared
       assembly this plugin asks for the line-of-sight traces, so it is only referenced (never copied next to this plugin). libs/RayTraceApi.dll is
       made by scripts/build-raytrace.sh. Without it this still builds, as a plugin that says it is switched off (RAYTRACE is not defined). -->
  <PropertyGroup Condition="Exists('libs/RayTraceApi.dll')">
    <DefineConstants>$(DefineConstants);RAYTRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('libs/RayTraceApi.dll')">
    <Reference Include="RayTraceApi">
      <HintPath>libs/RayTraceApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
