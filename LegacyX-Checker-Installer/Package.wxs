<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Installs for the current user only (no administrator needed), starts the checker, and is removed again by the checker itself once the result is sent. -->
  <Package Name="LEGACY-X Checker" Manufacturer="LEGACY-X" Version="1.0.0.0" UpgradeCode="6f0c7f7e-3c1b-4a54-9a0e-6a8d4f1f2c11" Scope="perUser" Compressed="yes">
    <!-- Every rebuilt installer replaces an older one, even with the same version number (otherwise Windows says "another version is already installed"). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer LEGACY-X Checker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="LegacyX-Checker">
        <Component Id="CheckerProgram" Guid="b2c5a1d4-8e37-4c0b-9f43-1d7e5a6b9c20">
          <File Id="CheckerExe" Source="$(ExePath)" Name="LegacyX-Checker.exe" KeyPath="no" />
          <RegistryValue Root="HKCU" Key="Software\LEGACY-X\Checker" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="LEGACY-X Checker" Level="1">
      <ComponentRef Id="CheckerProgram" />
    </Feature>

    <!-- The window: a dark sidebar on the left, what the checker does (license.rtf) with an "I accept", then progress, then a finish page that can start the checker. -->
    <WixVariable Id="WixUIDialogBmp" Value="Assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\banner.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="Assets\license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start the checker now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <ui:WixUI Id="WixUI_Minimal" />

    <CustomAction Id="StartChecker" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]LegacyX-Checker.exe&quot;" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartChecker" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
