// Copy to legacyx-rank.private.cfg on the CS2 server. Do not commit the copied file.
// This config enables MatchZy -> LEGACY-X AdminPlus API rank event delivery.
legacyx_rank_season "season-1"
matchzy_remote_log_url "https://api.legacyx.cc/api/plugin/matchzy/events"
matchzy_remote_log_header_key "x-plugin-secret"
matchzy_remote_log_header_value "REPLACE_WITH_PLUGIN_INGEST_SECRET"
