<Application x:Class="LegacyX.Checker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- The site's own palette: near-black, flat outlines, white as the one accent, red and green only for status. -->
    <SolidColorBrush x:Key="Bg" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Card" Color="#141414" />
    <SolidColorBrush x:Key="Raised" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Line" Color="#262626" />
    <SolidColorBrush x:Key="LineStrong" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Text" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Dim" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Faint" Color="#737373" />
    <SolidColorBrush x:Key="Red" Color="#EF4444" />
    <SolidColorBrush x:Key="Green" Color="#22C55E" />
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Glass: panels are a thin veil of white over the blurred window behind them -->
    <SolidColorBrush x:Key="GlassFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassLine" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TerminalGreen" Color="#22C55E" />

    <!-- A faint grid behind everything, like graph paper on a dark screen -->
    <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Viewbox="0,0,28,28" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,28,28" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#0BFFFFFF" Thickness="1" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><LineGeometry StartPoint="0,0" EndPoint="28,0" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#0BFFFFFF" Thickness="1" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><LineGeometry StartPoint="0,0" EndPoint="0,28" /></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Buttons: they fade on hover and give a little on press -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0A0A0A" />
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="18,0" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity" To="0.86" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#FAFAFA" />
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#333333" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The small buttons in the title bar -->
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A3A3A3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Hover" Background="#1F1F1F" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The code field: its outline brightens smoothly when you click into it -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#33000000" />
      <Setter Property="Foreground" Value="#FAFAFA" />
      <Setter Property="CaretBrush" Value="#FAFAFA" />
      <Setter Property="SelectionBrush" Value="#525252" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
              <Border x:Name="Ring" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A check box that looks like the rest of the site; the tick pops in -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FAFAFA" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="#0F0F0F" BorderBrush="#4A4A4A" BorderThickness="1" VerticalAlignment="Center">
                <Grid>
                  <Border x:Name="Fill" Background="#FAFAFA" CornerRadius="5" Opacity="0" />
                  <Path x:Name="Tick" Data="M0,5 L4,9 L12,0" Stroke="#0A0A0A" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                      <ScaleTransform x:Name="TickScale" ScaleX="0.5" ScaleY="0.5" />
                    </Path.RenderTransform>
                  </Path>
                </Grid>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                      <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                      <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                      <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                      <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.14" />
                      <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FAFAFA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scroll bar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#3A3A3A" CornerRadius="3" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
