# LEGACY-X SkinBridge operator template.
# This plugin reads WeaponPaints.json at runtime, not this file directly.
# Keep the real secret only on the CS2 server and copy these values into the
# generated CounterStrikeSharp plugin config according to README.md.

LEGACYX_API_BASE_URL=https://api.legacyx.cc
LEGACYX_PLUGIN_ID=legacyx-skinbridge
LEGACYX_PLUGIN_SECRET=REPLACE_WITH_SERVER_SCOPED_PLUGIN_TOKEN
LEGACYX_SERVER_ID=REPLACE_WITH_LEGACYX_SERVER_ID
LEGACYX_API_POLL_SECONDS=3
