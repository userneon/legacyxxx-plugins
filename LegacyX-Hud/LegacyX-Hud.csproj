<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CounterStrikeSharp.API 1.0.376 and PanoramaManager 0.4.x only ship net10.0; the server runs CounterStrikeSharp on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LegacyX-Hud</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- PanoramaManager needs CounterStrikeSharp.API 1.0.374 or newer (the custom_hud_layout API). -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PanoramaManager" Version="0.4.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/LegacyX.Shared.Configuration/LegacyX.Shared.Configuration.csproj" />
  </ItemGroup>
  <!-- The plugin loads through its own context, so PanoramaManager.dll must sit next to LegacyX-Hud.dll.
       This copies only that package (not the whole CounterStrikeSharp.API dependency tree). -->
  <Target Name="CopyPanoramaManager" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)"
                               Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'PanoramaManager'" />
    </ItemGroup>
  </Target>
</Project>
