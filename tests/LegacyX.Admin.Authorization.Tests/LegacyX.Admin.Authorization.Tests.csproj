<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for LegacyX-Admin's authorization core. The sources are linked, not referenced, so the
       tests need no CounterStrikeSharp runtime and nothing here ships in the plugin package. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LegacyX-Admin/Authorization/*.cs" Link="Authorization/%(Filename)%(Extension)" />
    <Compile Include="../../shared/LegacyX.Shared.Configuration/LegacyXEnvironment.cs" Link="Shared/LegacyXEnvironment.cs" />
    <Compile Include="../../shared/LegacyX.Shared.Configuration/LegacyXChat.cs" Link="Shared/LegacyXChat.cs" />
    <Compile Include="../../shared/LegacyX.Shared.Configuration/LegacyXEnvironmentLoader.cs" Link="Shared/LegacyXEnvironmentLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
