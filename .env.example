# LEGACY-X CounterStrikeSharp central runtime environment.
# Copy this file to CounterStrikeSharp/.env only on the future CS2 host.
# Never commit the real .env file or any real plugin token.
#
# Plugins use the Root API only. Do not put Supabase service-role, database,
# RCON, Steam, Discord, or web-browser credentials in plugin-local JSON/cfg.
# Optional server-side Discord webhooks belong only in this one central file.

# Shared server identity
LEGACYX_API_BASE_URL=https://api.legacyx.cc
LEGACYX_SERVER_ID=REPLACE_WITH_SERVER_ID
LEGACYX_SERVER_ADDRESS=REPLACE_WITH_HOST_AND_PORT
# Canonical backend/server mode. Only the Discord allowlisted mode emits match/status cards.
LEGACYX_SERVER_MODE=competitive_5v5

# Module switches. Gameplay defaults remain in secret-free JSON/cfg files.
LEGACYX_ADMIN_ENABLED=true
LEGACYX_AFKMANAGER_ENABLED=true
LEGACYX_COMMUNITY_ENABLED=true
LEGACYX_MATCHZY_ENABLED=true
LEGACYX_RECONNECT_ENABLED=true
LEGACYX_SPECTATOR_COMMS_ENABLED=true
LEGACYX_SKINBRIDGE_ENABLED=true
LEGACYX_PLAYER_TELEMETRY_ENABLED=true

# Scoped Root API identities. Use a different token per module/server.
LEGACYX_COMMUNITY_PLUGIN_ID=legacyx-community
LEGACYX_COMMUNITY_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN

LEGACYX_RECONNECT_PLUGIN_ID=legacyx-reconnect
LEGACYX_RECONNECT_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN

LEGACYX_MATCHZY_MATCH_CORE_ENABLED=false
LEGACYX_MATCHZY_MATCH_CORE_PLUGIN_ID=legacyx-match-core
LEGACYX_MATCHZY_MATCH_CORE_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN
LEGACYX_MATCHZY_MATCH_CORE_API_URL=https://api.legacyx.cc/api/v1/plugin/match-core/events

LEGACYX_SKINBRIDGE_PLUGIN_ID=legacyx-skinbridge
LEGACYX_SKINBRIDGE_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN
LEGACYX_SKINBRIDGE_POLL_SECONDS=3

# Player telemetry uses the Root API only; the plugin never receives database credentials.
LEGACYX_PLAYER_TELEMETRY_PLUGIN_ID=legacyx-player-telemetry
LEGACYX_PLAYER_TELEMETRY_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN

# Optional player-report Call channel only. All server/match/moderation/status/chat events stay website/API/database-only.
LEGACYX_ADMIN_CALL_CHANNEL_ENABLED=false
LEGACYX_ADMIN_CALL_CHANNEL_WEBHOOK=
LEGACYX_ADMIN_CALL_CHANNEL_MENTION=
