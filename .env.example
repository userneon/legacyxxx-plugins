# LEGACY-X CounterStrikeSharp central runtime environment.
# Copy this file to CounterStrikeSharp/.env only on the future CS2 host.
# Never commit the real .env file or any real plugin token.
#
# Plugins use the Root API only. Do not put Supabase service-role, database,
# RCON, Steam, Discord, or web-browser credentials in plugin-local JSON/cfg.
# Optional server-side Discord webhooks belong only in this one central file.

# Shared server identity
LEGACYX_API_BASE_URL=https://api.legacyx.cc
LEGACYX_SERVER_ID=REPLACE_WITH_SERVER_ID
LEGACYX_SERVER_ADDRESS=REPLACE_WITH_HOST_AND_PORT
# Name on the website's Play page and Discord boards (default: the server's hostname).
LEGACYX_SERVER_NAME=
# Optional GOTV address (host:port) for the "Watch" button.
LEGACYX_SERVER_GOTV_ADDRESS=
# Canonical backend/server mode. Only the Discord allowlisted mode emits match/status cards.
LEGACYX_SERVER_MODE=competitive_5v5

# Module switches. Gameplay defaults remain in secret-free JSON/cfg files.
LEGACYX_ADMIN_ENABLED=true
LEGACYX_AFKMANAGER_ENABLED=true
LEGACYX_COMMUNITY_ENABLED=true
LEGACYX_MATCHZY_ENABLED=true
LEGACYX_SPECTATOR_COMMS_ENABLED=true
LEGACYX_SKINBRIDGE_ENABLED=true
LEGACYX_STATUS_ENABLED=true

# Scoped Root API identities. Use a different token per module/server.
LEGACYX_COMMUNITY_PLUGIN_ID=legacyx-community
LEGACYX_COMMUNITY_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN

LEGACYX_MATCHZY_MATCH_CORE_ENABLED=false
LEGACYX_MATCHZY_MATCH_CORE_PLUGIN_ID=legacyx-match-core
LEGACYX_MATCHZY_MATCH_CORE_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN
LEGACYX_MATCHZY_MATCH_CORE_API_URL=https://api.legacyx.cc/api/v1/plugin/match-core/events

LEGACYX_SKINBRIDGE_PLUGIN_ID=legacyx-skinbridge
LEGACYX_SKINBRIDGE_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN
LEGACYX_SKINBRIDGE_POLL_SECONDS=3

# LegacyX-Status: reports this server (map, mode, players) and the live score to the website every
# 30 seconds: Play pages, home "Players Online", Discord /servers and /status. Token scope: servers:write.
LEGACYX_STATUS_PLUGIN_ID=legacyx-live-snapshot
LEGACYX_STATUS_PLUGIN_TOKEN=REPLACE_WITH_SCOPED_TOKEN
LEGACYX_STATUS_INTERVAL_SECONDS=30

# In-game staff come only from the LEGACY-X API (website staff + per-server assignments for
# LEGACYX_SERVER_ID). Nothing is read from or written to admins.json. The token needs admin:read
# (plus bans:read for central bans and bans:write for penalty records below).
# Fail closed: without these values, or while the API is unreachable, nobody gets new permissions.
LEGACYX_ADMIN_API_BASE_URL=https://api.legacyx.cc
LEGACYX_ADMIN_PLUGIN_ID=legacyx-admin
LEGACYX_ADMIN_PLUGIN_SECRET=REPLACE_WITH_SCOPED_TOKEN
# Online players are re-checked this often (15-600); revokes/role changes apply within one refresh.
LEGACYX_ADMIN_AUTH_REFRESH_SECONDS=60
# A grant not re-confirmed for this long (30-3600, above the refresh) is removed.
LEGACYX_ADMIN_AUTH_CACHE_SECONDS=180

# Central SteamID bans from the LEGACY-X database (Discord bot /ban, website). Checked on connect and
# every CENTRAL_BANS_SWEEP_SECONDS; uses the API URL and token above, which then needs bans:read.
# If the API is unreachable nobody is kicked. Local banned_user.cfg bans keep working either way.
LEGACYX_ADMIN_CENTRAL_BANS_ENABLED=false
LEGACYX_ADMIN_CENTRAL_BANS_SWEEP_SECONDS=30

# Game → API → database: in-game bans, unbans, mutes and gags are also recorded on the website
# (legacyx.cc/penalties, profiles, Discord feed); bans then apply on every server, and !unban by SteamID
# also lifts bans issued from the website or Discord. Same API URL and token, which then needs bans:write.
LEGACYX_ADMIN_CENTRAL_PENALTIES_ENABLED=true

# Optional player-report Call channel only. All server/match/moderation/status/chat events stay website/API/database-only.
LEGACYX_ADMIN_CALL_CHANNEL_ENABLED=false
LEGACYX_ADMIN_CALL_CHANNEL_WEBHOOK=
LEGACYX_ADMIN_CALL_CHANNEL_MENTION=
