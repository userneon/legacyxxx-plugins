# LEGACY-X CounterStrikeSharp central runtime environment.
#
# Easiest: don't fill this in by hand. On the VPS, in legacyxxx-backend, run
#   node --env-file=.env scripts/create-game-server.mjs <server-id> <host:port> [competitive_5v5|fun|proleague] [name]
# It creates the server's token and writes this whole file for it; upload that as
# game/csgo/addons/counterstrikesharp/.env. Never commit the real .env file or any real token.
#
# Plugins use the Root API only (game → API → database). Do not put Supabase service-role,
# database, RCON, Steam, Discord, or web-browser credentials in plugin-local JSON/cfg.

# Server identity
LEGACYX_API_BASE_URL=https://api.legacyx.cc
LEGACYX_SERVER_ID=REPLACE_WITH_SERVER_ID
LEGACYX_SERVER_ADDRESS=REPLACE_WITH_HOST_AND_PORT
# competitive_5v5 (5x5 page), fun, proleague: which Play page lists this server.
LEGACYX_SERVER_MODE=competitive_5v5
# Name on the website's Play page and Discord boards (default: the server's hostname).
LEGACYX_SERVER_NAME=
# Optional GOTV address (host:port) for the "Watch" button.
LEGACYX_SERVER_GOTV_ADDRESS=

# One token for every module. Scopes: admin:read bans:read bans:write stats:write matches:write
# servers:write skinchanger:read. A module-specific token (LEGACYX_<MODULE>_PLUGIN_TOKEN, and
# LEGACYX_ADMIN_PLUGIN_SECRET for LegacyX-Admin) overrides it for that module.
LEGACYX_PLUGIN_TOKEN=REPLACE_WITH_SERVER_TOKEN
LEGACYX_ADMIN_PLUGIN_SECRET=REPLACE_WITH_SERVER_TOKEN

# Module switches (all on by default). Gameplay defaults remain in secret-free JSON/cfg files.
LEGACYX_ADMIN_ENABLED=true
LEGACYX_AFKMANAGER_ENABLED=true
LEGACYX_COMMUNITY_ENABLED=true
LEGACYX_KILLFEED_ENABLED=true
LEGACYX_MATCHZY_ENABLED=true
LEGACYX_SPECTATOR_COMMS_ENABLED=true
LEGACYX_SKINBRIDGE_ENABLED=true
LEGACYX_STATUS_ENABLED=true

# LegacyX-MatchZy: map results → EXP and rank on the website (/plugin/matchzy/events), and the
# match lifecycle (/plugin/match-core/events). Both on when the token above is set.
LEGACYX_MATCHZY_RANK_ENABLED=true
LEGACYX_MATCHZY_MATCH_CORE_ENABLED=true

# LegacyX-WeaponPaints: how often (1-30 s) it picks up skins chosen on the website.
LEGACYX_SKINBRIDGE_POLL_SECONDS=3

# LegacyX-Status: this server (map, mode, players) and the live score to the website every
# 10-60 s: Play pages, home "Players Online", Discord /servers and /status.
LEGACYX_STATUS_PLUGIN_ID=legacyx-live-snapshot
LEGACYX_STATUS_INTERVAL_SECONDS=30

# LegacyX-Admin. In-game staff come only from the website (staff + per-server assignments for
# LEGACYX_SERVER_ID); admins.json is never read. Fail closed: while the API is unreachable nobody
# gets new permissions. Online players are re-checked every REFRESH seconds (15-600); a grant not
# re-confirmed within CACHE seconds (30-3600) is removed.
LEGACYX_ADMIN_AUTH_REFRESH_SECONDS=60
LEGACYX_ADMIN_AUTH_CACHE_SECONDS=180
# Bans from the website and Discord are enforced here: checked on connect and every SWEEP seconds.
# If the API is unreachable nobody is kicked. Local banned_user.cfg bans keep working either way.
LEGACYX_ADMIN_CENTRAL_BANS_ENABLED=true
LEGACYX_ADMIN_CENTRAL_BANS_SWEEP_SECONDS=30
# In-game bans, unbans, mutes and gags are recorded on the website too (penalties page, profiles,
# Discord feed); bans then apply on every server. An owner's !cleanbans clears every ban everywhere.
LEGACYX_ADMIN_CENTRAL_PENALTIES_ENABLED=true

# Optional player-report Call channel only. All server/match/moderation/status/chat events stay website/API/database-only.
LEGACYX_ADMIN_CALL_CHANNEL_ENABLED=false
LEGACYX_ADMIN_CALL_CHANNEL_WEBHOOK=
LEGACYX_ADMIN_CALL_CHANNEL_MENTION=
